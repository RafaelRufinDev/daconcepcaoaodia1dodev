# Configurações da Aplicação
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Banco de Dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aurora_dev
DB_PASS=aurora_dev_password
DB_NAME=aurora_core_db
DB_SSL=false

# Integrações e Segurança
JWT_SECRET=sua_chave_secreta_jwt_aqui
ANTI_FRAUD_SERVICE_URL=http://localhost:3001/verify
RISK_ENGINE=local
RISK_REVIEW_THRESHOLD_CENTS=500000
RISK_BLOCK_THRESHOLD_CENTS=1000000
BACEN_PIX_API_KEY=mock_key_para_desenvolvimento_local
ADMIN_API_KEY=dev_admin_key

# Proteção de dados (LGPD)
# Chave HMAC para pseudonimizar CPF (qualquer string longa e aleatória)
PII_HMAC_KEY=dev_hmac_key_troque_em_producao
# Chave AES-256-GCM em hexadecimal (64 caracteres = 32 bytes)
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Conta contábil interna utilizada como contraparte das transferências PIX
CLEARING_ACCOUNT_NUMBER=CLEARING-0001

# Endpoints de depósito sandbox (use false em produção)
ENABLE_SANDBOX_ENDPOINTS=true
